{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blockwright/stamp",
	"version": "1.1.0",
	"title": "Stamp",
	"category": "design",
	"icon": "star-filled",
	"description": "A rotated badge that sits over a container corner, like a rubber stamp. The color follows the site color scheme by default; set the corner, rotation, color, and text.",
	"keywords": [ "badge", "ribbon", "tag", "label", "popular", "recommended" ],
	"textdomain": "blockwright-blocks",
	"attributes": {
		"text": { "type": "rich-text", "source": "rich-text", "selector": "p" },
		"corner": { "type": "string", "default": "top-right" },
		"rotation": { "type": "number", "default": 18 },
		"offsetX": { "type": "number" },
		"offsetY": { "type": "number" },
		"borderType": { "type": "string", "default": "double" }
	},
	"supports": {
		"color": { "background": false, "text": true, "__experimentalDefaultControls": { "text": true } },
		"__experimentalBorder": { "color": true, "radius": true, "__experimentalDefaultControls": { "color": true } },
		"typography": { "fontSize": true },
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
